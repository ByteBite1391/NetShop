# Development Dockerfile — installs the full dev toolchain (pytest, linters).
# Used by docker-compose.yml for the dev profile.

FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev libffi-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app
COPY requirements/ ./requirements/
RUN pip install --upgrade pip && pip install -r requirements/dev.txt

# Source is mounted via compose for live reload; copy as a fallback.
COPY . .
