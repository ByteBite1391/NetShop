# ---- NexCart environment configuration ----
# Copy this file to .env and fill in real values. Never commit the real .env.

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-insecure-secret-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave empty for SQLite (dev) or set a Postgres URL (prod).
# Example: postgres://nexcart:secret@db:5432/nexcart
DATABASE_URL=postgres://nexcart_user:root@db:5432/nexcart

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS — list the frontend origins that may call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (production SMTP)
DEFAULT_FROM_EMAIL=NexCart <no-reply@nexcart.example>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
